{
  "name": "air-kya-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Know Your Agent (KYA) at the Cloudflare edge: gate content or triage callers by AIR SD-JWT credentials.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx dev/setup.ts",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "origin": "tsx examples/origin.ts",
    "agent": "tsx examples/agent.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@sd-jwt/core": "^0.24.3",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.161.0"
  }
}
